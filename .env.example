# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env itself.
# ---------------------------------------------------------------------------

# --- Database (Supabase) ---------------------------------------------------
# Two connection strings, used by two DIFFERENT database users. This is not a
# detail: it is what makes the database-level protection real.
#
#   DATABASE_URL -> the POOLED connection (port 6543), as the RESTRICTED user
#                   `app_user`. The running application uses this. Row-level
#                   policies apply to it, so it can only ever see one school
#                   at a time.
#
#   DIRECT_URL   -> the DIRECT connection (port 5432), as the OWNER
#                   (`postgres`). Used for migrations, seeding and creating
#                   the first account. The owner is a superuser and therefore
#                   IGNORES the policies, which is why the application must
#                   NOT use it.
#
# Find both in Supabase: Project Settings -> Database -> Connection string.
#
# Before first use, create the restricted user's password by running this on
# the DIRECT connection (the migration creates the role without one, so it
# cannot log in until you do):
#
#   ALTER ROLE app_user WITH PASSWORD 'choose-a-strong-password';
#
DATABASE_URL="postgresql://app_user:APP_USER_PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:POSTGRES_PASSWORD@HOST:5432/postgres"

# --- API -------------------------------------------------------------------
# Signs the login tokens. MUST be at least 32 characters and kept secret —
# anyone who knows it can mint valid sessions for any account.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a sign-in lasts before the app quietly renews it.
ACCESS_TOKEN_TTL=15m
# How long someone stays signed in without using the app.
REFRESH_TOKEN_TTL_DAYS=30

API_PORT=3001
NODE_ENV=development
# Which website address is allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# How many proxies stand between a caller and this API, so it can tell one
# person from another. A hosted deployment terminates TLS in front of the
# process, and until this says so, every caller looks like the proxy and the
# whole platform shares one sign-in rate limit — a class signing in together
# locks itself out. Use 1 behind a single host such as Render, 2 if a CDN sits
# in front of that, 0 for a developer machine with nothing in front.
# Never "true": that trusts a forged X-Forwarded-For and removes the limit.
# Left unset it assumes 1.
TRUSTED_PROXY_HOPS=0

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Email (Resend) --------------------------------------------------------
# Sends the "forgotten password" link. With no key set, nothing is sent and
# the link is written to the API's log instead — which is how recovery is
# walked through on a developer machine, and which makes a missing key in
# production loud rather than a silent failure that looks like it worked.
RESEND_API_KEY=
EMAIL_FROM="TOP GOAL <noreply@example.com>"

# Where the reset link points: the WEBSITE, not this API. Falls back to
# CORS_ORIGIN when unset, which is right for a single deployment.
WEB_BASE_URL=http://localhost:3000
# How long a reset link lasts. Long enough to act on after a lesson, short
# enough that a forwarded message stops working the same day.
PASSWORD_RESET_TTL_MINUTES=60
