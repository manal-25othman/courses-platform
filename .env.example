# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env itself.
# ---------------------------------------------------------------------------

# --- Database (Supabase) ---------------------------------------------------
# Two connection strings, used by two DIFFERENT database users. This is not a
# detail: it is what makes the database-level protection real.
#
#   DATABASE_URL -> the POOLED connection (port 6543), as the RESTRICTED user
#                   `app_user`. The running application uses this. Row-level
#                   policies apply to it, so it can only ever see one school
#                   at a time.
#
#   DIRECT_URL   -> the DIRECT connection (port 5432), as the OWNER
#                   (`postgres`). Used for migrations, seeding and creating
#                   the first account. The owner is a superuser and therefore
#                   IGNORES the policies, which is why the application must
#                   NOT use it.
#
# Find both in Supabase: Project Settings -> Database -> Connection string.
#
# Before first use, create the restricted user's password by running this on
# the DIRECT connection (the migration creates the role without one, so it
# cannot log in until you do):
#
#   ALTER ROLE app_user WITH PASSWORD 'choose-a-strong-password';
#
DATABASE_URL="postgresql://app_user:APP_USER_PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:POSTGRES_PASSWORD@HOST:5432/postgres"

# --- API -------------------------------------------------------------------
# Signs the login tokens. MUST be at least 32 characters and kept secret —
# anyone who knows it can mint valid sessions for any account.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a sign-in lasts before the app quietly renews it.
ACCESS_TOKEN_TTL=15m
# How long someone stays signed in without using the app.
REFRESH_TOKEN_TTL_DAYS=30

API_PORT=3001
NODE_ENV=development
# Which website address is allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Email (Resend) --------------------------------------------------------
# Not used until Phase 1 password recovery. Left here so setup is in one place.
RESEND_API_KEY=
EMAIL_FROM="TOP GOAL <noreply@example.com>"
