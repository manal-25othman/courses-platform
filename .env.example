# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env itself.
# ---------------------------------------------------------------------------

# --- Database (Supabase) ---------------------------------------------------
# Supabase gives you two connection strings. Both are needed:
#   DATABASE_URL -> the POOLED connection (port 6543). Used by the running app.
#   DIRECT_URL   -> the DIRECT connection (port 5432). Used for migrations.
# Find them in Supabase: Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- API -------------------------------------------------------------------
# Signs the login tokens. MUST be at least 32 characters and kept secret —
# anyone who knows it can mint valid sessions for any account.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a sign-in lasts before the app quietly renews it.
ACCESS_TOKEN_TTL=15m
# How long someone stays signed in without using the app.
REFRESH_TOKEN_TTL_DAYS=30

API_PORT=3001
NODE_ENV=development
# Which website address is allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Email (Resend) --------------------------------------------------------
# Not used until Phase 1 password recovery. Left here so setup is in one place.
RESEND_API_KEY=
EMAIL_FROM="TOP GOAL <noreply@example.com>"
