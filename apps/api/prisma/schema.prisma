// Interactive English Learning Platform — TOP GOAL
// Phase 0 baseline schema.
//
// Only the Settings store exists at this stage. It is the mechanism that keeps
// the values the SRS requires to stay changeable (passing score, attempt limit,
// progress weights, result policy, randomization, game effects) out of the code
// and in the database. See ARCHITECTURE.md section 5.9.
//
// Identity, tenancy, content, questions, assessments and progress models are
// Phase 1 onward and are deliberately NOT defined yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Scope at which a setting applies. Resolution runs from the most specific
/// scope to the least specific: ASSESSMENT -> UNIT -> COURSE -> SCHOOL -> GLOBAL.
enum SettingScope {
  GLOBAL
  SCHOOL
  COURSE
  UNIT
  ASSESSMENT

  @@map("setting_scope")
}

/// A single configuration value. Never read a rule from a constant in code —
/// read it from here, so it can be changed without a redeploy (SRS 17, 19, 21, 58).
model Setting {
  id        String       @id @default(uuid()) @db.Uuid
  scope     SettingScope
  /// Null for GLOBAL. Otherwise the id of the school / course / unit / assessment.
  scopeId   String?      @map("scope_id") @db.Uuid
  key       String
  value     Json
  /// User who last changed this value. Null for values created by seeding.
  updatedBy String?      @map("updated_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // NOTE: PostgreSQL treats NULLs as distinct, so this constraint does NOT
  // prevent duplicate GLOBAL rows (where scopeId is null). A partial unique
  // index must be added in the first real migration:
  //   CREATE UNIQUE INDEX settings_global_key_key
  //     ON settings (key) WHERE scope = 'GLOBAL';
  // Until then the seed script looks rows up explicitly rather than upserting.
  @@unique([scope, scopeId, key])
  @@index([key])
  @@map("settings")
}

// ---------------------------------------------------------------------------
// Phase 1 — Identity & Tenancy
// See ARCHITECTURE.md sections 5.1, 8, 9, 10, 11, 12.
// ---------------------------------------------------------------------------

/// The three roles from SRS sections 3, 4 and 5.
///
/// Stored as data so a future role can be added without restructuring
/// (SRS 44). What each role is *allowed to do* is enforced centrally in the
/// API and is never editable by a user (client decision, 2026-08-30).
enum UserRole {
  ADMIN
  TEACHER
  STUDENT

  @@map("user_role")
}

/// Whether an account may currently sign in.
enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// A school. Present from day one even though the first version has one,
/// because adding a tenant column to a live database later is the most
/// expensive migration in this kind of system (SRS 34, ARCHITECTURE 10).
model School {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  users    User[]
  messages Message[]

  @@map("schools")
}

/// A sign-in identity. One row per person, whatever their role.
model User {
  id       String   @id @default(uuid()) @db.Uuid
  /// Null ONLY for a platform admin, who sits above every school (SRS 3.1).
  /// Every other user belongs to exactly one school.
  schoolId String?  @map("school_id") @db.Uuid
  role     UserRole

  /// Students sign in with a username, not an email (SRS 27).
  username String
  /// Optional for students (SRS 28.3), required for teachers (SRS 28.5).
  /// The difference is enforced in the API, since it depends on the role.
  email    String?

  passwordHash       String  @map("password_hash")
  /// True after a teacher-issued temporary password, until the student
  /// chooses her own (SRS 28.6.2).
  mustChangePassword Boolean @default(false) @map("must_change_password")

  status      UserStatus @default(ACTIVE)
  /// Set when the account is deleted. Deletion is a reversible hide: the
  /// account stops working and disappears from normal lists, but all of her
  /// results, progress, answers and messages are preserved (SRS 27.1).
  deletedAt   DateTime?  @map("deleted_at")
  lastLoginAt DateTime?  @map("last_login_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  school         School?         @relation(fields: [schoolId], references: [id])
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  refreshTokens  RefreshToken[]

  // Phase 5 — her own progress. Kept on User rather than StudentProfile so a
  // record is never orphaned by a profile change.
  vocabularyProgress VocabularyProgress[]
  sectionProgress    SectionProgress[]
  activityAttempts   ActivityAttempt[]

  messagesAsTeacher Message[] @relation("messagesAsTeacher")
  messagesAsStudent Message[] @relation("messagesAsStudent")
  messagesSent      Message[] @relation("messagesSent")

  // A username is unique within its school, so two schools may each have a
  // student called "sara".
  // NOTE: PostgreSQL treats NULLs as distinct, so this does not constrain
  // platform admins (school_id null). Admin accounts are created deliberately
  // and are few; a partial unique index can be added if that changes.
  @@unique([schoolId, username])
  @@index([schoolId, role])
  @@index([email])
  @@map("users")
}

/// The teacher's own details. Her name is stored here and read from here —
/// never written into the interface — so changing it updates every place it
/// appears (SRS 33).
model TeacherProfile {
  userId        String  @id @map("user_id") @db.Uuid
  /// Shown as "Prepared and presented by Teacher [Name]" (SRS 33).
  displayName   String  @map("display_name")
  /// Used to build the Contact Teacher link (SRS 26). Not hard-coded.
  whatsappPhone String? @map("whatsapp_phone")
  title         String?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentProfile[]

  @@map("teacher_profiles")
}

/// The student's own details.
model StudentProfile {
  userId            String  @id @map("user_id") @db.Uuid
  fullName          String  @map("full_name")
  /// The teacher responsible for her (SRS 35). A teacher sees her own
  /// students, not the whole school.
  assignedTeacherId String? @map("assigned_teacher_id") @db.Uuid

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTeacher TeacherProfile? @relation(fields: [assignedTeacherId], references: [userId])

  @@index([assignedTeacherId])
  @@map("student_profiles")
}

/// A long-lived token that can mint new short-lived access tokens.
///
/// Only the hash is stored, so a database leak does not hand out sessions.
/// Each login starts a family; refreshing rotates within it. Presenting a
/// token that was already used means it was probably stolen, so the whole
/// family is revoked (ARCHITECTURE 8.2).
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  /// Which device this session belongs to, for the user's own reference.
  deviceLabel String?   @map("device_label")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// A record of sensitive actions, so it is always possible to answer
/// "who reset this student's password, and when?" (SRS 37, 28.6.3).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// e.g. "auth.login", "auth.login_failed", "student.password_reset"
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Phase 3 — Content model
//
// Shaped against the supplied TOP GOAL material rather than assumed. That file
// organises each unit into NINE numbered sections: General Question,
// Controlled Writing, Reading, Grammar, Vocabulary, Orthography, Handwriting,
// Writing, and a Reading passage. SRS 6 names only Vocabulary, Grammar,
// Activity, Games and Assessment, so section types are stored as DATA rather
// than fixed in code — the same approach used for question types (SRS 44, 45).
// ---------------------------------------------------------------------------

/// Whether content is visible to students yet.
///
/// Everything imported or newly written starts as DRAFT and reaches students
/// only after the teacher approves it (client decision, SRS 37.7).
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

/// A curriculum. Currently one: TOP GOAL, Grade 6.
model Course {
  id             String  @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  /// The school that owns and may edit this content.
  ownerSchoolId  String  @map("owner_school_id") @db.Uuid
  /// True for the master library every school may read but only the owner may
  /// change. A school-specific version is a copy with this false (SRS 37.2).
  isSharedMaster Boolean @default(true) @map("is_shared_master")
  /// Set on a copy, pointing at the master it came from.
  sourceCourseId String? @map("source_course_id") @db.Uuid

  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  units Unit[]

  @@index([ownerSchoolId])
  @@map("courses")
}

/// A unit of the curriculum.
///
/// The supplied file has a Welcome unit, four themed units (Living Things,
/// Lifestyles, Interests, Professions) and a Grammar Review section. Ordering
/// is by orderIndex; nothing counts units or refers to "unit 1" in code.
model Unit {
  id          String  @id @default(uuid()) @db.Uuid
  courseId    String  @map("course_id") @db.Uuid
  orderIndex  Int     @map("order_index")
  title       String
  /// e.g. "Welcome", "Grammar Review". Kept so preliminary and revision
  /// material can be distinguished from the themed units without a code rule.
  kind        String?
  description String?

  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections         UnitSection[]
  vocabularyItems  VocabularyItem[]
  questions        Question[]
  questionSets     QuestionSet[]
  activityAttempts ActivityAttempt[]

  @@unique([courseId, orderIndex])
  @@index([courseId])
  @@map("units")
}

/// The kinds of section a unit can contain.
///
/// A row per kind, so a curriculum that introduces another one needs data, not
/// a code change. Seeded from what the supplied file actually contains.
model SectionType {
  key               String  @id
  displayName       String  @map("display_name")
  description       String?
  /// True where the section is a list of vocabulary rather than prose.
  isVocabulary      Boolean @default(false) @map("is_vocabulary")
  /// True where the material is inherently on paper (handwriting practice),
  /// so it is presented for reference rather than answered on screen.
  isPaperBased      Boolean @default(false) @map("is_paper_based")
  /// Which part of the progress model this kind of section counts towards
  /// (SRS 16, 21): "vocabulary", "grammar", or null for a kind that is read
  /// but not counted.
  ///
  /// Data rather than a key written into the code, because which sections
  /// count is a curriculum decision the client has not settled — Reading,
  /// Writing, Orthography and Handwriting are real parts of this material and
  /// sit outside the four confirmed components. Changing what counts is
  /// changing this column, not changing the platform.
  progressComponent String? @map("progress_component")
  isActive          Boolean @default(true) @map("is_active")
  orderIndex        Int     @map("order_index")

  sections UnitSection[]

  @@map("section_types")
}

/// One numbered section within a unit.
model UnitSection {
  id         String  @id @default(uuid()) @db.Uuid
  unitId     String  @map("unit_id") @db.Uuid
  typeKey    String  @map("type_key")
  orderIndex Int     @map("order_index")
  title      String?
  /// The teaching text: an explanation, a reading passage, a writing prompt.
  body       String?
  /// Room for what one kind of section needs and another does not, without a
  /// column per kind.
  config     Json?

  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  unit      Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type      SectionType       @relation(fields: [typeKey], references: [key])
  media     MediaAsset[]
  questions Question[]
  progress  SectionProgress[]

  @@unique([unitId, orderIndex])
  @@index([unitId])
  @@map("unit_sections")
}

/// A word in a unit's vocabulary list (SRS 7).
///
/// The supplied file gives every word an Arabic meaning, so meaningAr carries
/// it. Pronunciation is generated at display time and is not stored (SRS 7).
model VocabularyItem {
  id              String  @id @default(uuid()) @db.Uuid
  unitId          String  @map("unit_id") @db.Uuid
  orderIndex      Int     @map("order_index")
  wordEn          String  @map("word_en")
  meaningAr       String? @map("meaning_ar")
  partOfSpeech    String? @map("part_of_speech")
  exampleSentence String? @map("example_sentence")
  /// Only set if a specific recording is ever supplied; normally empty,
  /// because pronunciation is produced automatically (SRS 7).
  audioUrl        String? @map("audio_url")

  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  unit     Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  progress VocabularyProgress[]

  @@unique([unitId, wordEn])
  @@index([unitId])
  @@map("vocabulary_items")
}

/// A picture belonging to a section.
///
/// The supplied file is image-heavy: 92 pictures, used by the reading,
/// writing, orthography and handwriting sections, and needed by the
/// picture-matching question type in SRS 10.
model MediaAsset {
  id         String   @id @default(uuid()) @db.Uuid
  sectionId  String?  @map("section_id") @db.Uuid
  /// Where to fetch the picture.
  ///
  /// For a picture the teacher uploaded this is this API's own route for the
  /// asset; for one she linked to, the address she gave.
  url        String
  mimeType   String   @map("mime_type")
  /// The file itself, for an uploaded picture.
  ///
  /// Kept in the database on purpose for the pilot: it needs no new service,
  /// works the moment the API is deployed, and moving to object storage later
  /// is a migration behind `url` rather than a change to anything that reads
  /// a picture. Size is capped in the API. Revisit if the library grows.
  data       Bytes?
  /// How big the file is, so a listing does not have to load it.
  byteSize   Int?     @map("byte_size")
  /// Describes the picture for a student using a screen reader.
  altText    String?  @map("alt_text")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  section UnitSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// Phase 4 — Question Engine
//
// Question kinds are rows, not code. Adding one is a row plus a handler; no
// table changes, and nothing else in the system needs to know (SRS 10, 44).
//
// The kinds registered here are the ones actually present in the supplied TOP
// GOAL material, plus those SRS 10 requires. "Odd one out" appears eight times
// in the file but is not named in SRS 10; grammar transformation is named in
// SRS 10 but does not appear in the file. Both are recorded rather than
// forced into a neighbouring kind.
// ---------------------------------------------------------------------------

model QuestionType {
  key                   String  @id
  displayName           String  @map("display_name")
  description           String?
  /// Whether shuffling the answer options makes sense for this kind.
  supportsOptionShuffle Boolean @default(true) @map("supports_option_shuffle")
  /// Whether the student types an answer rather than choosing one. Typed
  /// answers are compared as text, which is why they need accepted
  /// alternatives and are the likeliest to need a teacher's eye.
  isTyped               Boolean @default(false) @map("is_typed")
  /// Whether the question needs its picture to make sense (SRS 10).
  needsMedia            Boolean @default(false) @map("needs_media")
  /// False for a kind the platform supports but the supplied material does
  /// not use, so nothing is invented to fill it.
  presentInSource       Boolean @default(true) @map("present_in_source")
  isActive              Boolean @default(true) @map("is_active")
  orderIndex            Int     @map("order_index")

  questions Question[]

  @@map("question_types")
}

/// One question.
///
/// `payload` holds what this kind needs to be shown, and `answerKey` what it
/// needs to be marked. Neither has a fixed shape, so a new kind stores what it
/// needs without a schema change. The answer key never leaves the server.
model Question {
  id        String  @id @default(uuid()) @db.Uuid
  unitId    String  @map("unit_id") @db.Uuid
  sectionId String? @map("section_id") @db.Uuid
  typeKey   String  @map("type_key")

  /// The question as written in the curriculum. Never reworded.
  prompt     String
  payload    Json
  answerKey  Json   @map("answer_key")
  points     Int    @default(1)
  orderIndex Int    @default(0) @map("order_index")

  /// True when the import could not be certain of something. Such a question
  /// is held back from publication until a teacher has looked at it.
  needsReview Boolean @default(false) @map("needs_review")
  /// What exactly was uncertain, in plain words for the teacher.
  reviewNotes String? @map("review_notes")
  /// Where in the source document this came from, so it can be checked.
  sourceRef   String? @map("source_ref")

  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  unit           Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  section        UnitSection?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  type           QuestionType      @relation(fields: [typeKey], references: [key])
  sets           QuestionSetItem[]
  attemptAnswers AttemptAnswer[]

  @@index([unitId])
  @@index([sectionId])
  @@index([typeKey])
  @@index([needsReview])
  @@map("questions")
}

/// What a set of questions is for.
enum QuestionSetPurpose {
  ACTIVITY
  ASSESSMENT
  PRACTICE

  @@map("question_set_purpose")
}

/// How many questions a set draws.
enum SelectionMode {
  ALL
  RANDOM_N

  @@map("selection_mode")
}

/// A group of questions used together.
///
/// The count is never fixed in code: a set either uses everything it holds or
/// draws a given number at random (SRS 9, 46).
model QuestionSet {
  id      String             @id @default(uuid()) @db.Uuid
  unitId  String             @map("unit_id") @db.Uuid
  purpose QuestionSetPurpose @default(ACTIVITY)
  title   String

  selectionMode SelectionMode @default(ALL) @map("selection_mode")
  /// Used with RANDOM_N. Null means every question in the set.
  questionCount Int?          @map("question_count")

  /// Defaults come from the settings store; these override for one set.
  shuffleQuestions Boolean @default(true) @map("shuffle_questions")
  shuffleOptions   Boolean @default(true) @map("shuffle_options")

  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  unit  Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  items QuestionSetItem[]

  @@index([unitId])
  @@map("question_sets")
}

model QuestionSetItem {
  id         String @id @default(uuid()) @db.Uuid
  setId      String @map("set_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  orderIndex Int    @map("order_index")

  set      QuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([setId, questionId])
  @@index([setId])
  @@map("question_set_items")
}

// ---------------------------------------------------------------------------
// Phase 5 — the student's own progress through a unit.
//
// Everything here belongs to one student and records what she has done, never
// what the curriculum contains. Content lives in the models above and is
// shared; progress is personal and is never shared between schools.
// ---------------------------------------------------------------------------

/// How far a student has got with one word.
///
/// A word counts as learned only once she has both seen it and heard it. That
/// rule is SRS 22 and is stored as a setting (`vocabulary.completion_rule`),
/// so the two timestamps are recorded separately and the rule is applied when
/// progress is worked out, rather than being baked into a single flag.
model VocabularyProgress {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid

  /// When the card was first shown to her.
  seenAt        DateTime? @map("seen_at")
  /// When she played the pronunciation.
  audioPlayedAt DateTime? @map("audio_played_at")
  /// When she answered the check on this word correctly.
  ///
  /// Seeing and hearing a word can both be done by tapping through the cards
  /// quickly, which is not learning it. The check is the part that cannot be
  /// got through without knowing the answer.
  verifiedAt    DateTime? @map("verified_at")
  /// How many times she has tried the check. Kept so a teacher can see a word
  /// a student is struggling with, and so the shuffle differs on each try.
  checkAttempts Int       @default(0) @map("check_attempts")
  /// Set once the configured rule is satisfied. Kept as a column so a later
  /// change to the rule does not silently rewrite what a student has already
  /// completed.
  learnedAt     DateTime? @map("learned_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  item    VocabularyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([studentId, itemId])
  @@index([studentId])
  @@map("vocabulary_progress")
}

/// That a student has read a teaching section — grammar, reading, writing.
///
/// There is nothing to answer in these, so being shown one is all there is to
/// record.
model SectionProgress {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  sectionId String @map("section_id") @db.Uuid

  viewedAt DateTime @default(now()) @map("viewed_at")

  student User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section UnitSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sectionId])
  @@index([studentId])
  @@map("section_progress")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED

  @@map("attempt_status")
}

/// One run at a unit's activity questions.
///
/// Retries are unlimited for activities (SRS 9), so a student may have many of
/// these for one unit. Which attempt counts is the result policy in the
/// settings store (SRS 19), applied when progress is worked out.
model ActivityAttempt {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  unitId    String @map("unit_id") @db.Uuid

  /// Fixes the shuffle for this attempt, so leaving the page and coming back
  /// shows the same questions in the same order (SRS 11, 23).
  seed   String
  status AttemptStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now()) @map("started_at")
  submittedAt DateTime? @map("submitted_at")

  /// The result, written once at submission and never recalculated. Marking
  /// again later would use whatever the questions say then, which is exactly
  /// what must not happen to a result a student has already been given.
  correctCount    Int? @map("correct_count")
  incorrectCount  Int? @map("incorrect_count")
  pointsAwarded   Int? @map("points_awarded")
  pointsAvailable Int? @map("points_available")
  scorePercent    Int? @map("score_percent")

  student User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit    Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@index([studentId, unitId])
  @@map("activity_attempts")
}

/// One question inside one attempt, frozen.
///
/// `snapshot` holds the question exactly as it was put to the student —
/// wording, choices, answer key and marks. The attempt is marked from the
/// snapshot, never from the live question, so a teacher correcting a question
/// afterwards changes what future students see and leaves every past attempt
/// and result untouched.
///
/// `questionId` keeps the link for reporting and is allowed to go null if the
/// question is later removed; the snapshot survives either way.
model AttemptAnswer {
  id         String  @id @default(uuid()) @db.Uuid
  attemptId  String  @map("attempt_id") @db.Uuid
  questionId String? @map("question_id") @db.Uuid
  orderIndex Int     @map("order_index")

  snapshot Json
  response Json?

  isCorrect     Boolean? @map("is_correct")
  pointsAwarded Int?     @map("points_awarded")

  attempt  ActivityAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question?       @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, orderIndex])
  @@index([attemptId])
  @@map("attempt_answers")
}

/// A message between a teacher and one of her students.
///
/// Feedback on her work, and the student's reply. Deliberately not a chat: a
/// message is written, read and answered, with nothing live about it. One row
/// per message, ordered by time; a conversation is every message between the
/// same pair.
model Message {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  /// The teacher's side of the conversation.
  teacherId String @map("teacher_id") @db.Uuid
  /// The student's side.
  studentId String @map("student_id") @db.Uuid
  /// Who wrote this one. Always one of the two above.
  senderId  String @map("sender_id") @db.Uuid

  body String

  /// When the other person opened it. Null while it is still unread.
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  school  School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher User   @relation("messagesAsTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student User   @relation("messagesAsStudent", fields: [studentId], references: [id], onDelete: Cascade)
  sender  User   @relation("messagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([teacherId, studentId, createdAt])
  @@index([studentId, readAt])
  @@map("messages")
}
