// Interactive English Learning Platform — TOP GOAL
// Phase 0 baseline schema.
//
// Only the Settings store exists at this stage. It is the mechanism that keeps
// the values the SRS requires to stay changeable (passing score, attempt limit,
// progress weights, result policy, randomization, game effects) out of the code
// and in the database. See ARCHITECTURE.md section 5.9.
//
// Identity, tenancy, content, questions, assessments and progress models are
// Phase 1 onward and are deliberately NOT defined yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Scope at which a setting applies. Resolution runs from the most specific
/// scope to the least specific: ASSESSMENT -> UNIT -> COURSE -> SCHOOL -> GLOBAL.
enum SettingScope {
  GLOBAL
  SCHOOL
  COURSE
  UNIT
  ASSESSMENT

  @@map("setting_scope")
}

/// A single configuration value. Never read a rule from a constant in code —
/// read it from here, so it can be changed without a redeploy (SRS 17, 19, 21, 58).
model Setting {
  id        String       @id @default(uuid()) @db.Uuid
  scope     SettingScope
  /// Null for GLOBAL. Otherwise the id of the school / course / unit / assessment.
  scopeId   String?      @map("scope_id") @db.Uuid
  key       String
  value     Json
  /// User who last changed this value. Null for values created by seeding.
  updatedBy String?      @map("updated_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // NOTE: PostgreSQL treats NULLs as distinct, so this constraint does NOT
  // prevent duplicate GLOBAL rows (where scopeId is null). A partial unique
  // index must be added in the first real migration:
  //   CREATE UNIQUE INDEX settings_global_key_key
  //     ON settings (key) WHERE scope = 'GLOBAL';
  // Until then the seed script looks rows up explicitly rather than upserting.
  @@unique([scope, scopeId, key])
  @@index([key])
  @@map("settings")
}

// ---------------------------------------------------------------------------
// Phase 1 — Identity & Tenancy
// See ARCHITECTURE.md sections 5.1, 8, 9, 10, 11, 12.
// ---------------------------------------------------------------------------

/// The three roles from SRS sections 3, 4 and 5.
///
/// Stored as data so a future role can be added without restructuring
/// (SRS 44). What each role is *allowed to do* is enforced centrally in the
/// API and is never editable by a user (client decision, 2026-08-30).
enum UserRole {
  ADMIN
  TEACHER
  STUDENT

  @@map("user_role")
}

/// Whether an account may currently sign in.
enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// A school. Present from day one even though the first version has one,
/// because adding a tenant column to a live database later is the most
/// expensive migration in this kind of system (SRS 34, ARCHITECTURE 10).
model School {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  users User[]

  @@map("schools")
}

/// A sign-in identity. One row per person, whatever their role.
model User {
  id       String   @id @default(uuid()) @db.Uuid
  /// Null ONLY for a platform admin, who sits above every school (SRS 3.1).
  /// Every other user belongs to exactly one school.
  schoolId String?  @map("school_id") @db.Uuid
  role     UserRole

  /// Students sign in with a username, not an email (SRS 27).
  username String
  /// Optional for students (SRS 28.3), required for teachers (SRS 28.5).
  /// The difference is enforced in the API, since it depends on the role.
  email    String?

  passwordHash       String  @map("password_hash")
  /// True after a teacher-issued temporary password, until the student
  /// chooses her own (SRS 28.6.2).
  mustChangePassword Boolean @default(false) @map("must_change_password")

  status      UserStatus @default(ACTIVE)
  /// Set when the account is deleted. Deletion is a reversible hide: the
  /// account stops working and disappears from normal lists, but all of her
  /// results, progress, answers and messages are preserved (SRS 27.1).
  deletedAt   DateTime?  @map("deleted_at")
  lastLoginAt DateTime?  @map("last_login_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  school         School?         @relation(fields: [schoolId], references: [id])
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  refreshTokens  RefreshToken[]

  // A username is unique within its school, so two schools may each have a
  // student called "sara".
  // NOTE: PostgreSQL treats NULLs as distinct, so this does not constrain
  // platform admins (school_id null). Admin accounts are created deliberately
  // and are few; a partial unique index can be added if that changes.
  @@unique([schoolId, username])
  @@index([schoolId, role])
  @@index([email])
  @@map("users")
}

/// The teacher's own details. Her name is stored here and read from here —
/// never written into the interface — so changing it updates every place it
/// appears (SRS 33).
model TeacherProfile {
  userId        String  @id @map("user_id") @db.Uuid
  /// Shown as "Prepared and presented by Teacher [Name]" (SRS 33).
  displayName   String  @map("display_name")
  /// Used to build the Contact Teacher link (SRS 26). Not hard-coded.
  whatsappPhone String? @map("whatsapp_phone")
  title         String?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentProfile[]

  @@map("teacher_profiles")
}

/// The student's own details.
model StudentProfile {
  userId            String  @id @map("user_id") @db.Uuid
  fullName          String  @map("full_name")
  /// The teacher responsible for her (SRS 35). A teacher sees her own
  /// students, not the whole school.
  assignedTeacherId String? @map("assigned_teacher_id") @db.Uuid

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTeacher TeacherProfile? @relation(fields: [assignedTeacherId], references: [userId])

  @@index([assignedTeacherId])
  @@map("student_profiles")
}

/// A long-lived token that can mint new short-lived access tokens.
///
/// Only the hash is stored, so a database leak does not hand out sessions.
/// Each login starts a family; refreshing rotates within it. Presenting a
/// token that was already used means it was probably stolen, so the whole
/// family is revoked (ARCHITECTURE 8.2).
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  /// Which device this session belongs to, for the user's own reference.
  deviceLabel String?   @map("device_label")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// A record of sensitive actions, so it is always possible to answer
/// "who reset this student's password, and when?" (SRS 37, 28.6.3).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// e.g. "auth.login", "auth.login_failed", "student.password_reset"
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Phase 3 — Content model
//
// Shaped against the supplied TOP GOAL material rather than assumed. That file
// organises each unit into NINE numbered sections: General Question,
// Controlled Writing, Reading, Grammar, Vocabulary, Orthography, Handwriting,
// Writing, and a Reading passage. SRS 6 names only Vocabulary, Grammar,
// Activity, Games and Assessment, so section types are stored as DATA rather
// than fixed in code — the same approach used for question types (SRS 44, 45).
// ---------------------------------------------------------------------------

/// Whether content is visible to students yet.
///
/// Everything imported or newly written starts as DRAFT and reaches students
/// only after the teacher approves it (client decision, SRS 37.7).
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

/// A curriculum. Currently one: TOP GOAL, Grade 6.
model Course {
  id             String  @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  /// The school that owns and may edit this content.
  ownerSchoolId  String  @map("owner_school_id") @db.Uuid
  /// True for the master library every school may read but only the owner may
  /// change. A school-specific version is a copy with this false (SRS 37.2).
  isSharedMaster Boolean @default(true) @map("is_shared_master")
  /// Set on a copy, pointing at the master it came from.
  sourceCourseId String? @map("source_course_id") @db.Uuid

  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  units Unit[]

  @@index([ownerSchoolId])
  @@map("courses")
}

/// A unit of the curriculum.
///
/// The supplied file has a Welcome unit, four themed units (Living Things,
/// Lifestyles, Interests, Professions) and a Grammar Review section. Ordering
/// is by orderIndex; nothing counts units or refers to "unit 1" in code.
model Unit {
  id          String  @id @default(uuid()) @db.Uuid
  courseId    String  @map("course_id") @db.Uuid
  orderIndex  Int     @map("order_index")
  title       String
  /// e.g. "Welcome", "Grammar Review". Kept so preliminary and revision
  /// material can be distinguished from the themed units without a code rule.
  kind        String?
  description String?

  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections        UnitSection[]
  vocabularyItems VocabularyItem[]

  @@unique([courseId, orderIndex])
  @@index([courseId])
  @@map("units")
}

/// The kinds of section a unit can contain.
///
/// A row per kind, so a curriculum that introduces another one needs data, not
/// a code change. Seeded from what the supplied file actually contains.
model SectionType {
  key          String  @id
  displayName  String  @map("display_name")
  description  String?
  /// True where the section is a list of vocabulary rather than prose.
  isVocabulary Boolean @default(false) @map("is_vocabulary")
  /// True where the material is inherently on paper (handwriting practice),
  /// so it is presented for reference rather than answered on screen.
  isPaperBased Boolean @default(false) @map("is_paper_based")
  isActive     Boolean @default(true) @map("is_active")
  orderIndex   Int     @map("order_index")

  sections UnitSection[]

  @@map("section_types")
}

/// One numbered section within a unit.
model UnitSection {
  id         String  @id @default(uuid()) @db.Uuid
  unitId     String  @map("unit_id") @db.Uuid
  typeKey    String  @map("type_key")
  orderIndex Int     @map("order_index")
  title      String?
  /// The teaching text: an explanation, a reading passage, a writing prompt.
  body       String?
  /// Room for what one kind of section needs and another does not, without a
  /// column per kind.
  config     Json?

  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  unit  Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type  SectionType  @relation(fields: [typeKey], references: [key])
  media MediaAsset[]

  @@unique([unitId, orderIndex])
  @@index([unitId])
  @@map("unit_sections")
}

/// A word in a unit's vocabulary list (SRS 7).
///
/// The supplied file gives every word an Arabic meaning, so meaningAr carries
/// it. Pronunciation is generated at display time and is not stored (SRS 7).
model VocabularyItem {
  id              String  @id @default(uuid()) @db.Uuid
  unitId          String  @map("unit_id") @db.Uuid
  orderIndex      Int     @map("order_index")
  wordEn          String  @map("word_en")
  meaningAr       String? @map("meaning_ar")
  partOfSpeech    String? @map("part_of_speech")
  exampleSentence String? @map("example_sentence")
  /// Only set if a specific recording is ever supplied; normally empty,
  /// because pronunciation is produced automatically (SRS 7).
  audioUrl        String? @map("audio_url")

  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, wordEn])
  @@index([unitId])
  @@map("vocabulary_items")
}

/// A picture belonging to a section.
///
/// The supplied file is image-heavy: 92 pictures, used by the reading,
/// writing, orthography and handwriting sections, and needed by the
/// picture-matching question type in SRS 10.
model MediaAsset {
  id         String   @id @default(uuid()) @db.Uuid
  sectionId  String?  @map("section_id") @db.Uuid
  /// Where the file is stored. No binary data is kept in the database.
  url        String
  mimeType   String   @map("mime_type")
  /// Describes the picture for a student using a screen reader.
  altText    String?  @map("alt_text")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  section UnitSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("media_assets")
}
